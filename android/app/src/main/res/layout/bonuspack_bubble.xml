<?xml version="1.0" encoding="utf-8"?>
<!--
  Substitui o balão branco padrão do osmdroid (mesmo nome de arquivo: o do app vence o da
  biblioteca). Os quatro ids são os que o MarkerInfoWindow procura; não remova nenhum.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/argos_bubble"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/bubble_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bubble_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxEms="16"
            android:textColor="#C9A227"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubble_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxEms="16"
            android:textColor="#E8E2D0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/bubble_subdescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="16"
            android:textColor="#8A8578"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
